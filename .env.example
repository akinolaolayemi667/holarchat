# RelayChat — copy to .env.local and fill in values from your Supabase project.
# Never commit .env.local. Never put service-role keys in NEXT_PUBLIC_* vars.

# --- Required (public / browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Current Supabase docs name: publishable key (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy alias still accepted by this app if you only have the classic anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# App origin used for auth redirects (local default)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 4 signaling (exact URL of the Node Socket.IO server)
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4001

# --- Server-only (optional in Phase 2; never expose to the browser) ---
# SUPABASE_SERVICE_ROLE_KEY=
# Use only in trusted server/admin tooling — not in Client Components.

# --- Later phases ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
