# RelayChat signaling server (Phase 4+)
# Copy to server/.env for local development. Never commit server/.env.

# development | production — guest identity is REJECTED in production
NODE_ENV=development

# Exact frontend origin (no wildcard). Must match the Next.js app.
CORS_ORIGIN=http://localhost:3000

# Listen port
PORT=4001

# Dev-only guest handshake. Must be true for localhost testing.
# In production this is ignored / forced off — connections with guest auth fail closed.
ALLOW_GUEST_IDENTITY=true

# Dev-only: allow GET /turn-credentials (also requires ALLOW_GUEST_IDENTITY=true).
# Always fail-closed in production until real authenticated identity exists.
ALLOW_TURN_CREDENTIALS=true

# --- TURN (optional; leave unset for STUN-only lab) ---
# Comma-separated TURN/TURNS URLs for your coturn (or compatible) server.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349

# Preferred: coturn REST API shared secret (server-side only).
# Coturn must be configured with the same static-auth-secret.
# TURN_HMAC_SECRET=replace-with-long-random-secret

# Alternative local lab only: long-lived username/password (still server-side).
# Prefer HMAC. Do not put these in NEXT_PUBLIC_*.
# TURN_USERNAME=labuser
# TURN_CREDENTIAL=labpass

# Credential TTL for minted iceServers (seconds)
TURN_CREDENTIAL_TTL_SECONDS=3600

# Optional shared secret for minting/verifying future non-guest tokens (not used by guests)
# SIGNALING_SHARED_SECRET=

# Rate limits
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_EVENTS=40

# Max JSON string length for SDP / ICE payloads
MAX_SIGNAL_PAYLOAD_CHARS=65536
